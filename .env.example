# Copiar a .env (mismo directorio que docker-compose.yml) y cambiar los valores.
# .env NO se sube a git. Sin .env, docker-compose.yml usa valores de prueba locales.

# ---- Base de datos (contenedor "db") ----
DB_NAME=unifex
DB_USER=unifex
DB_PASSWORD=cambiar-esta-clave
# Puerto en ESTA maquina para entrar con pgAdmin/DBeaver (solo 127.0.0.1)
DB_PUERTO_LOCAL=5433
# true = la base nace con categorias, casetas, vendedores y ventas de ejemplo.
# Solo tiene efecto la PRIMERA vez (volumen vacio). Para cambiarlo: docker compose down -v
CARGAR_DATOS_PRUEBA=true

# ---- Aplicacion (contenedor "app") ----
APP_PUERTO=7676
# Clave del API interno (cabecera X-API-KEY)
API_KEY=cambiar-esta-clave-api
# Secreto para firmar los JWT: 32 caracteres o mas
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
# Contrasenas de los usuarios fundadores. Solo se usan en el PRIMER arranque.
ADMIN1_PASSWORD=cambiar-admin1
ADMIN2_PASSWORD=cambiar-admin2
# URL con la que los usuarios llegan al sistema (enlaces en mensajes y QR)
UNIFEX_PUBLICO_BASE_URL=http://localhost:7676
# Opcional: URL de verificacion que va en el QR de la nota de venta, p. ej.
# https://fexpo.uap.edu.bo/verificar?c=
NOTA_VERIFICACION_URL=
